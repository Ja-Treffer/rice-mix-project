/* ══════ 分隔页 ══════ */
function section(file, num, pno, big, sub, footText, flip) {
  newPage(file, BLACK);
  const NX = flip ? 592 : 48, TX = flip ? 48 : 400;
  T('num', NX, 120, 320, num, { size: 130, bold: true, color: ORANGE, gap: 0 });
  T('stitle', TX, 170, 500, big, { size: 38, bold: true, color: WHITE, gap: 0 });
  T('sdesc', TX, 330, 480, sub, { size: 20, color: MUT_D, gap: 0 });
  T('foot', 48, 492, 700, footText, { size: 9, color: MUT_D, gap: 0 });
  pageNo(pno);
}

