/* 米水配比 STEM 汇报 · PPTD 生成器（v2：流式布局 + 高度富余，避免 overflow） */
const fs = require('fs');
const path = require('path');

const OUT = 'E:/hardness/ricemix/present/deck';
const P = 'pages';
fs.rmSync(path.join(OUT, P), { recursive: true, force: true });
fs.mkdirSync(path.join(OUT, P), { recursive: true });

const ORANGE = '#E85D26';
const BLACK = '#121212';
const CREAM = '#F2EDE4';
const WHITE = '#FFFFFF';
const INKC = '#121212';
const MUT_D = '#EDE6DA';
const MUT_L = '#5C5850';

const pages = [];
let cur = null;

/* 按框宽估算实际行数，再算高度（中文字宽 = 字号，其它 0.56 倍） */
function estLines(s, sz, w) {
  let n = 0;
  for (const ln of String(s).split('\n')) {
    let px = 0;
    for (const ch of ln) px += /[\u3000-\u9fff\uff00-\uffef]/.test(ch) ? sz : sz * 0.56;
    n += Math.max(1, Math.ceil(px / Math.max(40, w - 10)));
  }
  return n;
}
const hOf = (sz, s, w = 400) => Math.ceil(estLines(s, sz, w) * sz * 1.78 + sz * 0.56);

function T(id, x, y, w, s, o = {}) {
  const sz = o.size || 20;
  cur.push({
    elementId: id,
    elementType: 'text',
    bounds: [x, y, w, o.h || hOf(sz, s, w)],
    content: {
      text: String(s).replace(/\n+$/, '') + '\n',
      style: Object.assign(
        { fontSize: sz, fontFace: 'Microsoft YaHei', color: o.color || INKC },
        o.bold ? { bold: true } : {},
        o.align ? { align: o.align } : {}
      )
    }
  });
  return y + (o.h || hOf(sz, s, w)) + (o.gap == null ? 6 : o.gap);
}

/* 列布局：从 y 开始依次往下排，返回结束 y */
function col(x, y, w, items) {
  let yy = y;
  for (const it of items) {
    yy = T(it[0], x, yy, it[2] || w, it[1], it[3] || {});
  }
  return yy;
}

function newPage(file, bg) {
  cur = [];
  pages.push({ file: P + '/' + file, bg, els: cur });
}

function writeAll() {
  const yamlEscape = (s) => s;
  for (const pg of pages) {
    let s = `background: "${pg.bg}"\nelements:\n`;
    for (const e of pg.els) {
      s += `  - elementId: ${e.elementId}\n`;
      s += `    elementType: text\n`;
      s += `    bounds: [${e.bounds.join(', ')}]\n`;
      s += `    content:\n`;
      s += `      text: |\n`;
      for (const ln of e.content.text.replace(/\n$/, '').split('\n')) s += `        ${ln}\n`;
      s += `      style:\n`;
      for (const [k, v] of Object.entries(e.content.style)) {
        s += `        ${k}: ${k === 'color' ? `"${v}"` : v}\n`;
      }
    }
    fs.writeFileSync(path.join(OUT, pg.file), s, 'utf8');
  }
  const m = `version: v2\nsize: [960, 540]\ntitle: 米水配比系统 · STEM 项目汇报\npages:\n` +
    pages.map(p => `  - ${p.file}\n`).join('');
  fs.writeFileSync(path.join(OUT, 'deck.pptd'), m, 'utf8');
}

/* 通用页头 */
function head(label, color) {
  T('sec', 48, 24, 820, label, { size: 11, color: color || MUT_D, gap: 10 });
}
function pageNo(k, color) {
  T('page', 862, 494, 50, String(k), { size: 11, color: color || MUT_D, align: 'right', gap: 0 });
}

